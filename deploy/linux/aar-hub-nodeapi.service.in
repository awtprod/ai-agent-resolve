[Unit]
Description=AI-Agent-Resolve hub: node API for the Windows Resolve node (tailnet IP only)
Wants=tailscaled.service
After=network-online.target tailscaled.service

[Service]
ExecStart=@AAR_ROOT@/venv/bin/aar hub nodeapi --db @AAR_ROOT@/data/hub.db --host @TAILNET_IP@ --port 8789 --allow-remote
User=@AAR_USER@
Group=@AAR_GROUP@
WorkingDirectory=@AAR_ROOT@/data
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=@AAR_ROOT@/data
UMask=0077
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
