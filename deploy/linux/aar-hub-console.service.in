[Unit]
Description=AI-Agent-Resolve hub: human console (loopback; tailnet via tailscale serve :8449)
After=network.target

[Service]
ExecStart=@AAR_ROOT@/venv/bin/aar hub console --db @AAR_ROOT@/data/hub.db --artifacts @AAR_ROOT@/data/artifacts --host 127.0.0.1 --port 8788 --trust-tailscale-headers --allowed-host @CONSOLE_HOSTNAME@
User=@AAR_USER@
Group=@AAR_GROUP@
WorkingDirectory=@AAR_ROOT@/data
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=@AAR_ROOT@/data
UMask=0077
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
