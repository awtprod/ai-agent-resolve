# Environment of the hub units (EnvironmentFile). Rendered by install-units.sh; review it.
# The recipe modules the MCP server, the console and the worker load (recipe_create needs it).
AAR_RECIPES=aar.recipes.ccn
# Where hub media lives (the proxies); recipe params must name files under it.
AAR_MEDIA_ROOT=@AAR_MEDIA_ROOT@
# Whisper models (faster-whisper / CTranslate2 directories); never downloaded.
AAR_MODEL_DIR=@AAR_MEDIA_ROOT@/models
# The YuNet face model file (aar analyze faces).
AAR_YUNET_MODEL=@AAR_MEDIA_ROOT@/models/face_detection_yunet_2023mar.onnx
# Scratch for transcripts, renders and laughs (removed after each step; not /tmp).
AAR_WORK_DIR=@AAR_WORK_DIR@
# The edit PC's mapped share: <project>/<timeline>/ gets the FCPXML and the review MP4.
AAR_EXPORT_DIR=@AAR_EXPORT_DIR@
